# SQLAlchemy async MySQL DSN (aiomysql driver)
DATABASE_URL=mysql+aiomysql://root:@localhost:3306/myrouter

# /admin dashboard
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
SECRET_KEY=generate-a-long-random-string

# ComfyUI instances live in the MySQL `comfy_instances` table (managed from
# the /admin dashboard). The knobs below only affect the built-in workflow:
COMFY_CHECKPOINT=epicrealism_naturalSinRC1VAE.safetensors
COMFY_NEGATIVE_PROMPT=text, watermark, lowres, bad anatomy, blurry
COMFY_STEPS=25
COMFY_CFG=7.0
COMFY_POLL_INTERVAL=2.0
COMFY_TIMEOUT=300
# Used when a request sends size "auto" (9Router does)
COMFY_DEFAULT_SIZE=1024x1024
# Self-provisioning via ComfyUI-Manager V3.41 (install missing nodes / download
# missing models from a supplied workflow). Global defaults; each image request
# can override with "auto_provision"/"ephemeral". Installs are slow -> off by
# default; the provision wait uses COMFY_PROVISION_TIMEOUT seconds.
COMFY_AUTO_PROVISION=false
COMFY_PROVISION_TIMEOUT=1800
# Ephemeral: don't keep MyRouter's work on the shared ComfyUI boxes
# (SaveImage -> PreviewImage temp output + delete the history entry after each job).
COMFY_EPHEMERAL=false

# Google auth lifecycle
# file -> DB cookie sync period, seconds
PROFILE_SYNC_INTERVAL=600
# max seconds for the interactive login started from the dashboard
LOGIN_TIMEOUT=600
# Per-machine login command override (default: "<python> -m notebooklm login").
# "--storage <profile path>" is appended automatically and NOTEBOOKLM_PROFILE
# is set for the subprocess so each profile uses its own browser session.
# To switch the Google account of an EXISTING profile, temporarily add
# --fresh (clears that profile's cached browser session). Examples:
#LOGIN_COMMAND=notebooklm login --browser msedge
#LOGIN_COMMAND=notebooklm login --browser msedge --fresh
#LOGIN_COMMAND=python -m notebooklm login --browser chrome
# When auth expires during an API call, run the login subprocess automatically
# and retry once. Usually silent (persistent browser session), but a headed
# browser window may appear on the server host if Google forces a fresh login.
AUTO_RELOGIN=true
# seconds an API call waits for the auto re-login before returning 502
AUTO_RELOGIN_WAIT=60

# Emit the OpenAI "data: [DONE]" SSE terminator (standard). Set false if a
# downstream router (e.g. 9Router) leaks [DONE] into its non-stream aggregated
# JSON — then omitting it can produce clean aggregated output.
SSE_INCLUDE_DONE=true

# Vision: max size (MB) per input image. Image INPUT works; under a temporary
# Google rate-limit you may occasionally see APIError 1096/1100 (retry later).
# Image OUTPUT (web + Gemini-generated images) is returned in message.images
# and rendered by the playground.
VISION_MAX_IMAGE_MB=20
# Function calling for Gemini is prompt-EMULATED (the web backend has no
# native tool API). false -> ignore `tools` and answer as plain chat.
TOOL_EMULATION=true
# notebooklm-py server-side cookie-rotation keepalive, seconds
NOTEBOOK_KEEPALIVE=600

# --- Microsoft Copilot (/copilot/v1) ---
# One session dir per account under this root (git-ignored; holds cookies +
# MSAL token + Playwright profile). Multi-account: each copilot key binds to a
# Copilot profile whose session lives in <root>/<name>/.
COPILOT_SESSION_ROOT=copilot_sessions
# Per-machine login command override (default: "<python> scripts/copilot_login.py").
# The account's session dir is always appended as the final argument.
#COPILOT_LOGIN_COMMAND=python scripts/copilot_login.py
COPILOT_LOGIN_TIMEOUT=600
# Try a HEADLESS Cloudflare-clearance refresh on expiry before failing. Default
# false: headless Turnstile solving is unreliable and can hang a request, so a
# stale-clearance request fails fast with 503 clearance_required — re-clear via
# the dashboard/CLI login on a machine WITH A DISPLAY. (Clearance lasts ~30 min;
# a headless server cannot earn fresh clearance on its own.)
COPILOT_HEADLESS_CLEAR=false

LOG_LEVEL=INFO
